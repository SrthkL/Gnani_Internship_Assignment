# Local defaults. For deployment use platform variables or .env.production.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE?sslmode=require
STORAGE_DIR=./storage
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_LANGUAGE=en-IN
GNANI_POLL_SECONDS=10
AUDIO_CHUNK_SECONDS=240
# Cloud: use a reachable OpenAI-compatible endpoint ending in /v1.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2:3b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=180
# Google OAuth web client; callback is APP_URL/api/auth/google/callback.
APP_URL=http://localhost:3000
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_HOURS=24
GUEST_RESULT_MINUTES=60
